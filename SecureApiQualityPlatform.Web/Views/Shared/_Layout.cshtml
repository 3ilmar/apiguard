<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Secure API Quality Platform</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">API Quality</a>
        <div class="navbar-nav">
            <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
            <a class="nav-link" asp-controller="Apis" asp-action="Index">APIs</a>
            <a class="nav-link" asp-controller="Defects" asp-action="Index">Defects</a>
            <a class="nav-link" asp-controller="Reports" asp-action="ExportResultsCsv">Export Results</a>
        </div>
    </div>
</nav>
<main class="container py-4">
    @RenderBody()
</main>
</body>
</html>
