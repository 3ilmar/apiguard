@inject SecureApiQualityPlatform.Web.Services.IRoleProvider Roles
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Secure API Quality Platform</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">API Quality</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="Apis" asp-action="Index">APIs</a>
                <a class="nav-link" asp-controller="Defects" asp-action="Index">Defects</a>
                <a class="nav-link" asp-controller="Reports" asp-action="ExportResultsCsv">Export Results</a>
            </div>

            <form asp-controller="Role" asp-action="SetRole" method="post" class="d-flex ms-auto align-items-center">
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <label class="text-light small me-2" for="roleSelect">Role</label>
                <select id="roleSelect" name="role" class="form-select form-select-sm me-2" onchange="this.form.submit()">
                    @foreach (var r in Enum.GetValues<UserRole>())
                    {
                        <option value="@r" selected="@(r == Roles.CurrentRole)">@r</option>
                    }
                </select>
                <noscript>
                    <button type="submit" class="btn btn-sm btn-outline-light">Set</button>
                </noscript>
            </form>
        </div>
    </nav>
    <main class="container py-4">
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        @RenderBody()
    </main>
</body>
</html>