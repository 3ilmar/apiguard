@model ApiDetailsViewModel
@{
    ViewData["Title"] = Model.Api.Name;
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div><h1 class="h3">@Model.Api.Name</h1><code>@Model.Api.BaseUrl</code></div>
    <form asp-action="RunChecks" asp-route-id="@Model.Api.Id" method="post"><button class="btn btn-success" type="submit">Run all checks</button></form>
</div>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header">Endpoints</div>
            <div class="table-responsive"><table class="table mb-0"><thead><tr><th>Name</th><th>Method</th><th>Path</th><th>Expected</th><th>Threshold</th></tr></thead><tbody>
            @if (Model.Api.Endpoints.Count == 0) { <tr><td colspan="5" class="text-muted">Add an endpoint to start testing.</td></tr> }
            @foreach (var ep in Model.Api.Endpoints) { <tr><td>@ep.Name</td><td>@ep.Method</td><td><code>@ep.Path</code></td><td>@ep.ExpectedStatusCode</td><td>@ep.MaxResponseTimeMs ms</td></tr> }
            </tbody></table></div>
        </div>
        <div class="card">
            <div class="card-header">Recent results</div>
            <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Check</th><th>Result</th><th>Message</th></tr></thead><tbody>
            @if (Model.RecentResults.Count == 0) { <tr><td colspan="3" class="text-muted">No results yet.</td></tr> }
            @foreach (var r in Model.RecentResults) { <tr><td>@r.CheckType</td><td><span class="badge @(r.Passed ? "text-bg-success" : "text-bg-danger")">@(r.Passed ? "PASS" : "FAIL")</span></td><td>@r.Message</td></tr> }
            </tbody></table></div>
        </div>
    </div>
    <div class="col-lg-5">
        <form asp-action="AddEndpoint" asp-route-id="@Model.Api.Id" method="post" class="card card-body">
            <h2 class="h5">Add endpoint</h2>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-2"><label class="form-label">Name</label><input asp-for="NewEndpoint.Name" name="Name" class="form-control"/></div>
            <div class="mb-2"><label class="form-label">Path</label><input asp-for="NewEndpoint.Path" name="Path" class="form-control" placeholder="/v1/orders"/></div>
            <div class="mb-2"><label class="form-label">Method</label><select asp-for="NewEndpoint.Method" name="Method" class="form-select"><option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option><option>DELETE</option></select></div>
            <div class="mb-2"><label class="form-label">Expected HTTP status</label><input asp-for="NewEndpoint.ExpectedStatusCode" name="ExpectedStatusCode" class="form-control"/></div>
            <div class="mb-2"><label class="form-label">Max response time (ms)</label><input asp-for="NewEndpoint.MaxResponseTimeMs" name="MaxResponseTimeMs" class="form-control"/></div>
            <div class="mb-2"><label class="form-label">Expected content type</label><input asp-for="NewEndpoint.ExpectedContentType" name="ExpectedContentType" class="form-control" placeholder="application/json"/></div>
            <div class="form-check mb-3"><input asp-for="NewEndpoint.RequiresAuthentication" name="RequiresAuthentication" class="form-check-input"/><label class="form-check-label">Requires authentication</label></div>
            <button class="btn btn-primary" type="submit">Add endpoint</button>
        </form>
    </div>
</div>
