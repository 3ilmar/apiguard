@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">API Quality Dashboard</h1>
        <p class="text-muted mb-0">Current prototype evidence for quality, performance, and defects.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Apis" asp-action="Create">Register API</a>
</div>
<div class="row g-3 mb-4" role="group" aria-label="Quality metrics">
    <div class="col-md-3"><div class="metric-card"><span>Registered APIs</span><strong>@Model.ApiCount</strong></div></div>
    <div class="col-md-3"><div class="metric-card"><span>Configured endpoints</span><strong>@Model.EndpointCount</strong></div></div>
    <div class="col-md-3"><div class="metric-card"><span>Executed checks</span><strong>@Model.ExecutedChecks</strong></div></div>
    <div class="col-md-3"><div class="metric-card"><span>Pass rate</span><strong>@(Model.ExecutedChecks == 0 ? "N/A" : $"{Model.PassRatePercent}%")</strong></div></div>
    <div class="col-md-3"><div class="metric-card"><span>Passed / Failed</span><strong>@Model.PassedChecks / @Model.FailedChecks</strong></div></div>
    <div class="col-md-3"><div class="metric-card"><span>Avg response</span><strong>@(Model.TimedChecks == 0 ? "N/A" : $"{Model.AverageResponseTimeMs} ms")</strong></div></div>
    <div class="col-md-3"><div class="metric-card"><span>Open defects</span><strong>@Model.OpenDefects</strong></div></div>
    <div class="col-md-3"><div class="metric-card"><span>High/Critical open</span><strong>@Model.OpenHighOrCriticalDefects</strong></div></div>
</div>
<section class="card mb-4" aria-labelledby="severity-title">
    <h2 class="card-header h6 mb-0" id="severity-title">Open defect severity distribution</h2>
    <div class="card-body">
        @if (Model.OpenDefects == 0)
        {
            <p class="text-muted mb-0" role="status">No open defects to classify.</p>
        }
        else
        {
            @foreach (var severity in Enum.GetValues<DefectSeverity>().Reverse())
            {
                var count = Model.OpenDefectsBySeverity.TryGetValue(severity, out var observed) ? observed : 0;
                var percent = 100.0 * count / Model.OpenDefects;
                var colour = severity switch
                {
                    DefectSeverity.Critical => "bg-danger",
                    DefectSeverity.High => "bg-warning",
                    DefectSeverity.Medium => "bg-info",
                    _ => "bg-secondary"
                };
                <div class="severity-row mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>@severity</span><strong>@count</strong>
                    </div>
                    <div class="progress" role="progressbar" aria-label="@severity open defects" aria-valuenow="@count" aria-valuemin="0" aria-valuemax="@Model.OpenDefects">
                        <div class="progress-bar @colour" style="width: @(percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                </div>
            }
            <p class="text-muted small mb-0">Counts exclude Closed and Deferred defects. Numbers are displayed alongside colours.</p>
        }
    </div>
</section>
<div class="row g-4">
    <div class="col-lg-7">
        <section class="card" aria-labelledby="recent-checks-title">
            <h2 class="card-header h6 mb-0" id="recent-checks-title">Recent checks</h2>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th scope="col">Check</th><th scope="col">Result</th><th scope="col">Response</th><th scope="col">When</th></tr></thead>
                    <tbody>
                    @if (Model.RecentResults.Count == 0)
                    {
                        <tr><td colspan="4" class="text-muted">No checks have been run yet.</td></tr>
                    }
                    @foreach (var r in Model.RecentResults)
                    {
                        <tr>
                            <td class="text-break">@r.CheckType<br /><small class="text-muted">@r.Message</small></td>
                            <td><span class="badge @(r.Passed ? "text-bg-success" : "text-bg-danger")">@(r.Passed ? "PASS" : "FAIL")</span></td>
                            <td>@(r.ResponseTimeMs.HasValue ? $"{r.ResponseTimeMs.Value} ms" : "N/A")</td>
                            <td><time datetime="@r.ExecutedAtUtc.ToString("O")">@r.ExecutedAtUtc.ToLocalTime().ToString("g")</time></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
    <div class="col-lg-5">
        <section class="card" aria-labelledby="recent-defects-title">
            <h2 class="card-header h6 mb-0" id="recent-defects-title">Recent defects</h2>
            <div class="list-group list-group-flush">
                @if (Model.RecentDefects.Count == 0)
                {
                    <div class="list-group-item text-muted">No defects recorded.</div>
                }
                @foreach (var d in Model.RecentDefects)
                {
                    <div class="list-group-item text-break">
                        <div class="d-flex justify-content-between gap-2"><strong>@d.Title</strong><span>@d.Severity</span></div>
                        <small class="text-muted">@d.Status · @d.Priority</small>
                    </div>
                }
            </div>
        </section>
    </div>
</div>
